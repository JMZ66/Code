{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://office-kit.local/schema/finding.schema.json",
  "title": "OfficeKitCheckReport",
  "type": "object",
  "required": ["origin_note", "documents", "findings", "warnings"],
  "additionalProperties": true,
  "properties": {
    "origin_note": {"type": "string"},
    "documents": {"type": "array"},
    "warnings": {"type": "array"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "rule_id", "severity", "origin", "category", "message", "evidence"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "rule_id": {"type": "string"},
          "severity": {"enum": ["error", "warning", "info"]},
          "origin": {"enum": ["source", "inference"]},
          "category": {"enum": ["确定错误", "疑似冲突", "缺少依据", "需要人工判断"]},
          "message": {"type": "string"},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["source_path", "sha256", "anchor", "quote"],
              "properties": {
                "source_path": {"type": "string"},
                "sha256": {"type": "string"},
                "anchor": {"type": "string"},
                "quote": {"type": "string"},
                "part": {"type": "string"}
              }
            }
          },
          "details": {"type": "object"}
        }
      }
    }
  }
}
